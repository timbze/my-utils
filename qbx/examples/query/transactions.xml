<?xml version="1.0" encoding="utf-8"?>
<?qbxml version="13.0"?>
<!-- All transactions that touch one account in a date range, any type. Returns TxnID, TxnType,
     date, amount and name per transaction; query the type itself (CheckQueryRq etc.) for lines. -->
<QBXML>
  <QBXMLMsgsRq onError="continueOnError">
    <TransactionQueryRq requestID="1">
      <TransactionDateRangeFilter>
        <FromTxnDate>2026-01-01</FromTxnDate>
        <ToTxnDate>2026-01-31</ToTxnDate>
      </TransactionDateRangeFilter>
      <TransactionAccountFilter>
        <FullName>Checking</FullName>
      </TransactionAccountFilter>
      <TransactionDetailLevelFilter>SummaryOnly</TransactionDetailLevelFilter>
    </TransactionQueryRq>
  </QBXMLMsgsRq>
</QBXML>
