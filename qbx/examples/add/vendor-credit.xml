      <VendorCreditAdd>
        <VendorRef>
          <FullName>Sample Vendor</FullName>
        </VendorRef>
        <TxnDate>2026-01-20</TxnDate>
        <RefNumber>CM-17</RefNumber>
        <Memo>[import 2026-01a] Credit for a damaged item</Memo>
        <ExpenseLineAdd>
          <AccountRef>
            <FullName>Office Supplies</FullName>
          </AccountRef>
          <Amount>20.00</Amount>
          <Memo>Damaged item</Memo>
        </ExpenseLineAdd>
      </VendorCreditAdd>
    </VendorCreditAddRq>
  </QBXMLMsgsRq>
