<?xml version="1.0" encoding="utf-8"?>
<?qbxml version="13.0"?>
<!-- A purchase on a credit card account. A refund on the card is CreditCardCreditAddRq with the
     same elements. Paying the card from the bank is a check (or transfer) to the card account. -->
<QBXML>
  <QBXMLMsgsRq onError="continueOnError">
    <CreditCardChargeAddRq requestID="1">
      <CreditCardChargeAdd>
        <AccountRef>
          <FullName>Credit Card</FullName>
        </AccountRef>
        <PayeeEntityRef>
          <FullName>Sample Vendor</FullName>
        </PayeeEntityRef>
        <TxnDate>2026-01-12</TxnDate>
        <Memo>[import 2026-01a] Fuel</Memo>
        <ExpenseLineAdd>
          <AccountRef>
            <FullName>Automobile Expense</FullName>
          </AccountRef>
          <Amount>60.00</Amount>
        </ExpenseLineAdd>
      </CreditCardChargeAdd>
    </CreditCardChargeAddRq>
  </QBXMLMsgsRq>
</QBXML>
