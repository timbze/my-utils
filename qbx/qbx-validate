#!/usr/bin/env bash
# Checks qbXML requests against the qbXML 13.0 schema in schema/, without QuickBooks.
# Prints nothing for a valid request; for an invalid one, each error with its line number.
# Requests for a newer qbXML version are skipped with a note. If python3 is installed, it also
# checks that each IncludeRetElement names a field the response has (QuickBooks silently returns
# nothing for any other name), which the schema cannot check. It also flags characters beyond
# Latin-1, such as curly quotes and dashes: QuickBooks rejects the whole request over one.
# Needs xmllint (libxml2-utils on Debian/Ubuntu, libxml2 on Arch and Homebrew).
#
#   qbx-validate request.xml [more.xml ...]
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: qbx-validate <request.xml> [more.xml ...]" >&2
  exit 1
fi
if ! command -v xmllint >/dev/null; then
  echo "qbx-validate: xmllint not found (install libxml2-utils or libxml2)" >&2
  exit 1
fi

dir="$(dirname "$(readlink -f "$0")")"

# Prints each character above U+00FF with its line and an ASCII stand-in; fails if there is one.
check_chars() {
  perl -CSD -ne '
    BEGIN { %ascii = ("\x{2018}" => "\x27", "\x{2019}" => "\x27", "\x{201C}" => "\"", "\x{201D}" => "\"",
                      "\x{2013}" => "-", "\x{2014}" => "-", "\x{2026}" => "...") }
    while (/([^\x{0}-\x{FF}])/g) {
      $found = 1;
      $fix = exists $ascii{$1} ? " Use $ascii{$1} instead." : "";
      printf STDERR "%s:%d: \"%s\" (U+%04X) is not in Latin-1; QuickBooks rejects the whole request over it.%s\n",
        $ARGV, $., $1, ord $1, $fix;
    }
    END { exit 1 if $found }
  ' "$1"
}
schema="$dir/schema/qbxmlops130.xsd"

status=0
for req in "$@"; do
  version=$(sed -n 's/.*<?qbxml[^>]*version *= *"\([0-9.]*\)".*/\1/p' "$req" | head -1)
  if [[ -z "$version" ]]; then
    echo "$req: no <?qbxml version=\"...\"?> line; QuickBooks needs one" >&2
    status=1
    continue
  fi
  if ! awk -v v="$version" 'BEGIN { exit !(v + 0 <= 13.0) }'; then
    echo "$req: not checked, the schema here is qbXML 13.0 and the request asks for $version" >&2
    continue
  fi
  if ! out=$(xmllint --noout --schema "$schema" "$req" 2>&1); then
    grep -v ' fails to validate$' <<<"$out" >&2
    status=1
  elif grep -q IncludeRetElement "$req" && command -v python3 >/dev/null \
    && ! "$dir/qbx-skeleton" --check-include "$req"; then
    status=1
  fi
  check_chars "$req" || status=1
done
exit $status
